# Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram ---
# my.telegram.org -> API development tools. ОДИН api_id на ОДИН номер.


# Строку выдаёт: python login.py
# ЭТО ПОЛНОЦЕННЫЙ ДОСТУП К АККАУНТУ. Никому не показывать, в git не коммитить.
TG_SESSION=

# Кому отвечаем. Пусто = режим наблюдения: логируем, но не отвечаем никому.
# Свой id печатает login.py. Несколько — через запятую.
TG_WHITELIST=

# --- Модель ---
# cloud.cerebras.ai. ВАЖНО: нужно привязать карту, иначе API не активен и любой
# запрос вернёт 402. Привязка даёт $5 кредитов на 30 дней, списаний без вашего
# согласия нет. Лимиты пробного тарифа: 5 запросов/мин, 1M токенов/сутки.
CEREBRAS_API_KEY=


# Фиксируйте seed на ручной проверке качества: одинаковые вопросы дают
# сравнимые прогоны. В обычной работе оставьте пустым.
LLM_SEED=

# --- Напоминания ---
# on (по умолчанию) — за день и за 2 часа до визита. Это ЕДИНСТВЕННОЕ, что
# уходит клиенту первым; идёт через Sender, значит слушается файла STOP и
# белого списка. off — выключить; тогда бот про напоминания и не обещает.
# Работают только пока запущен main.py.
REMINDERS=

# --- окно администратора (этап 2) ---
# off по умолчанию: этап 1 работает ровно как раньше, пока окно не включат.
INBOX=off
# Токен обязателен при INBOX=on — без него окно не поднимется и напечатает
# готовую строку. ТОЛЬКО латиница, цифры и знаки: заголовки HTTP кодируются в
# ASCII, кириллицу браузер не отправит.
INBOX_TOKEN=
INBOX_PORT=8000

# --- добор сообщений, пришедших пока процесс лежал ---
# Сколько часов назад смотреть при старте. 0 выключает добор совсем.
# Берутся только чаты, где последнее слово за клиентом (мы не отвечали).
CATCHUP_HOURS=12
